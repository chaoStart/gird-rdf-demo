# 默认不依赖数据库。环境变量需由 PowerShell / shell 设置，本文件不自动加载。
GRID_BACKEND=local
# 确认数据库类型后配置，下面仅为 GraphDB 示例，不会新启动数据库。
SPARQL_QUERY_URL=http://127.0.0.1:7200/repositories/grid-demo
SPARQL_UPDATE_URL=http://127.0.0.1:7200/repositories/grid-demo/statements
SPARQL_GRAPH=https://example.org/grid-demo
# 可选；不要提交或分享实际令牌
SPARQL_BEARER_TOKEN=

# 推荐使用现有 Neo4j：GRID_BACKEND=neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_PASSWORD=
